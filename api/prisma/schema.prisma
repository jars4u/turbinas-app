generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Vehiculo {
    id            Int     @id @default(autoincrement())
    vehiculo      String
    placa         String
    servicio      String
    arrivalTime   BigInt
    observaciones String?
    customerName  String?
    customerPhone String?
    status        String  @default("servicio")
    precio        Float?
}

model Usuario {
    id       Int    @id @default(autoincrement())
    usuario  String @unique
    clave    String
    admin    Boolean @default(false)
}
