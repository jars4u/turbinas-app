rules_version = '2';

// Reglas de seguridad de Firestore.
//
// Principio: solo los MIEMBROS del negocio acceden a los datos. Un miembro es un
// usuario autenticado que además tiene su documento en /usuarios/{uid}.
//
// No basta con "estar autenticado": la API key de Firebase es pública (viaja en
// el JS de la app) y el alta de cuentas por email está habilitada, así que
// cualquiera podría crearse una cuenta. El documento en /usuarios solo lo puede
// crear un owner (desde Configuración > Usuarios), y eso es lo que da acceso.
//
// ANTES DE PUBLICAR: verificar que cada usuario de Authentication tenga su
// documento en /usuarios con el mismo UID; quien no lo tenga perderá el acceso.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function isMember() {
      return isSignedIn() && exists(userDoc());
    }

    function isOwner() {
      return isMember() && get(userDoc()).data.get('owner', false) == true;
    }

    function isAdmin() {
      return isMember() && (get(userDoc()).data.get('admin', false) == true || isOwner());
    }

    // Usuarios y roles
    match /usuarios/{uid} {
      // Cada usuario lee su propio documento (roles); admin/owner leen la lista
      allow get: if isSignedIn() && uid == request.auth.uid;
      allow read: if isAdmin();

      // Alta y baja de usuarios: solo owner
      allow create, delete: if isOwner();

      // El owner cambia cualquier dato (incluidos roles)
      allow update: if isOwner();
      // Cada usuario puede editar su propio perfil, pero nunca sus roles
      allow update: if isSignedIn() && uid == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['admin', 'owner', 'observer']);
    }

    // Resto de colecciones del negocio (vehículos, ingresos, egresos, clientes,
    // caja chica, nómina, inventario, configuración, notas, etc.) y sus
    // subcolecciones: acceso completo para miembros.
    match /{coleccion}/{documento=**} {
      allow read, write: if coleccion != 'usuarios' && isMember();
    }
  }
}
